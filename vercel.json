{
  "functions": {
    "api/upload.js": { "maxDuration": 30 },
    "api/judge.js": { "maxDuration": 30 },
    "api/recap.js": { "maxDuration": 30 },
    "api/cleanup.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cleanup", "schedule": "0 4 * * *" }
  ],
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.lockoutbingo.nl" }],   "destination": "https://lockoutbingo.nl/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "lockout-bingo.nl" }],       "destination": "https://lockoutbingo.nl/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "lockout-bingo.online" }],   "destination": "https://lockoutbingo.nl/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "lockoutbingo.online" }],    "destination": "https://lockoutbingo.nl/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "stad-bingo.nl" }],          "destination": "https://lockoutbingo.nl/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "stadbingo.nl" }],           "destination": "https://lockoutbingo.nl/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "stadbingo.online" }],       "destination": "https://lockoutbingo.nl/:path*", "permanent": true }
  ]
}
